# Copy to deploy/.env and fill in. Never commit .env.

# Public hostname pointing at this VM (DNS A/AAAA record). Caddy gets the TLS certificate.
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# Single = one implicit organization for everyone; Multi = users create organizations and invite members.
TENANCY_MODE=Multi
DEFAULT_ORGANIZATION_NAME=Default

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Transactional email (Postmark, Resend, SES, ... over SMTP).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Illiria <no-reply@example.com>

# Images: leave unset to build on the VM, or point at your registry (e.g. ghcr.io/<owner>/illiria-api:<tag>).
# API_IMAGE=
# WEB_IMAGE=

# Backups (deploy/backup.sh): optional rclone remote for off-site copies, e.g. r2:illiria-backups
# RCLONE_REMOTE=
